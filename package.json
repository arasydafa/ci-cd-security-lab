{
  "name": "ci-cd-security-lab",
  "version": "2.0.0",
  "private": true,
  "description": "Interactive CI/CD Security Learning Lab - simulate, learn, and master pipeline security",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "sim": "node packages/cli/dist/index.js",
    "serve": "node packages/server/dist/index.js",
    "web": "npm run dev --workspace=packages/web"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
